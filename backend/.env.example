# Configuración del Laboratorio de Preprocesamiento de Video
ENVIRONMENT=development
PROJECT_NAME="Video Pipeline Lab - Phase 0"
DEBUG=true

# Host & Ports
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_MB=500

# Capa 3: AI Semántica (Groq Cloud - Ultrarrápido)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"
